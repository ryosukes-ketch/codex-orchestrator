APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/macro_release_scanner
TEST_DATABASE_URL=sqlite+aiosqlite:///./data/test.db

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

OPENCLAW_BASE_URL=http://127.0.0.1:8080
OPENCLAW_TIMEOUT_SECONDS=60
OPENCLAW_MAX_RETRIES=1
OPENCLAW_RETRY_BACKOFF_SECONDS=0.75
OPENCLAW_CHAT_FAILURE_COOLDOWN_SECONDS=120
OPENCLAW_GATEWAY_PROBE_TIMEOUT_SECONDS=10
OPENCLAW_AGENT_ID=codex-orchestrator
OPENCLAW_BACKEND_MODEL=
OPENCLAW_LIVE_CONTRACT_TIMEOUT_SECONDS=60
OPENCLAW_LIVE_CONTRACT_MAX_RETRIES=1
OPENCLAW_LIVE_CONTRACT_RETRY_BACKOFF_SECONDS=0.75
RUN_LIVE_LLM_CONTRACT=0

STATE_BACKEND=sqlite
STATE_BACKEND_STRICT=true
SQLITE_DB_PATH=data/codex.db
SQLITE_BACKUP_DIR=logs/sqlite-backups
TREND_PROVIDER_STRICT=false
# Auth service mode:
# - dev_token        : uses DEV_AUTH_* mapping (default, backward compatible)
# - commercial_token : uses AUTH_* mapping (no implicit dev token fallback)
AUTH_SERVICE_MODE=dev_token
AUTH_ENABLED=true
AUTH_TOKEN_SEED=
AUTH_TOKEN_STORE_PATH=logs/auth/commercial-token-store.json
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN_SEED=dev_auth_seed

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
API_WRITE_TOKEN=

KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
BLS_BASE_URL=https://www.bls.gov
BEA_BASE_URL=https://www.bea.gov
FED_BASE_URL=https://www.federalreserve.gov

DISPLAY_TIMEZONE=Asia/Tokyo
POLL_INTERVAL_SECONDS=5
ACTIVE_RELEASE_WINDOW_MINUTES=180
SKIP_REMOTE_SCHEDULE_INGESTION=false

REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=0.5

MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=60
MONITORING_TELEGRAM_CHAT_ID=
MONITORING_ALERT_COOLDOWN_CRITICAL_SECONDS=900
MONITORING_ACTUAL_MISSING_GRACE_SECONDS=300
MONITORING_NO_SIGNAL_GRACE_SECONDS=600
MONITORING_SIGNAL_BURST_THRESHOLD=30
MONITORING_SIGNAL_BURST_MARKET_THRESHOLD=5
MONITORING_NOTIFICATION_FAILURE_BURST_THRESHOLD=3

OPERATOR_API_TIMEOUT_SECONDS=30
INTAKE_USE_LLM=0
INTAKE_MODEL=mock
